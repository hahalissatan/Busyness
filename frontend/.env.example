# --- Frontend Environment Variables ---
#
# This file documents the env vars needed for the frontend.
# In Vercel, set these under Project Settings > Environment Variables.
#
# VITE_API_BASE_URL — The backend API URL.
#   In development: Leave unset. The Vite proxy routes /api to localhost:3001.
#   In production (Vercel): Set to your Render backend URL, e.g.:
#     VITE_API_BASE_URL=https://busyness-api.onrender.com
#
# Do NOT include a trailing slash.
VITE_API_BASE_URL=
