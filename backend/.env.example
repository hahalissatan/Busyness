# --- Busyness Backend Configuration ---
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Port the backend API server listens on
PORT=3001

# Runtime environment: development | production
NODE_ENV=development

# --- Database ---
# Use either DATABASE_URL or individual DB_* variables.
# DATABASE_URL takes precedence if set.
# Example for hosted PostgreSQL (SSL is auto-enabled for non-local hosts):
#   DATABASE_URL=postgresql://user:password@db.example.com:5432/busyness
DATABASE_URL=postgresql://busyness:busyness@localhost:5432/busyness
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busyness
DB_USER=busyness
DB_PASSWORD=busyness

# --- SSL ---
# Controls SSL for the database connection.
# "true"  = always require SSL (rejectUnauthorized: true)
# "false" = never use SSL
# unset   = auto-detect (SSL for non-localhost hosts, off for localhost)
DB_SSL=

# --- JWT / Authentication ---
# JWT_SECRET: secret key for signing JWT access tokens.
#   MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-chars-long

# JWT_EXPIRES_IN: token lifetime. Examples: "7d", "1h", "30m"
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed origins for cross-origin requests.
# In development, localhost origins (5173, 3000, 8080) are auto-allowed.
# In production, ONLY origins listed here are allowed — no wildcards.
# Example: http://localhost:5173,https://bizpilot.ai
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
# General rate limit (applies to all routes except health checks)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth rate limit (applies to /api/auth/* — stricter for brute-force protection)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# --- Conversational AI (Stage 2B) ---
# These variables configure the LLM provider for the conversational AI chat
# endpoint (POST /api/businesses/:businessId/agent/chat).
#
# If none of these are set, the system uses a mock LLM provider that produces
# clearly-labelled deterministic responses. No external API calls are made.
#
# To enable a live LLM provider, set ONE of these API keys:
#   OPENAI_API_KEY=sk-your-key-here
#   AI_API_KEY=your-key-here
#
# Optional provider configuration (defaults shown):
#   AI_API_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#
# SECURITY: Never hardcode API keys in source code. Only set them in this
# .env file, which should never be committed to version control.
